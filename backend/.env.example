# 数据库配置
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/hex_auth

# JWT配置
# 生产环境务必替换为随机密钥，生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# RSA私钥主密钥（Fernet），用于加密存储各产品的RSA私钥
# 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 一旦设定请妥善保存：丢失后数据库中已加密的产品私钥将无法恢复
RSA_MASTER_KEY=change-me-to-a-fernet-key

# 登录限流（可选，按「用户名+IP」统计失败次数）
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# 公开接口按IP限流（可选，每分钟）
ACTIVATE_RATE_LIMIT_PER_MINUTE=10
HEARTBEAT_RATE_LIMIT_PER_MINUTE=120

# CORS白名单，逗号分隔；生产环境设置为管理后台的实际访问地址
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=True
